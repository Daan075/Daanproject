# Kopieer dit bestand naar ".env" en vul je eigen API-sleutel in.
# Een sleutel maak je aan op https://console.anthropic.com (onder "API Keys").
ANTHROPIC_API_KEY=

# ---- Optioneel: alles hieronder heeft al een goede standaardwaarde ----

# Claude-modellen voor het bekijken van beelden en voor het zoeken.
# claude-sonnet-5-5 is ongeveer half zo duur, claude-haiku-5-5 veel goedkoper maar minder nauwkeurig.
#VISION_MODEL=claude-opus-5-5
#SEARCH_MODEL=claude-opus-5-5

# Whisper-model voor spraak naar tekst: tiny, base, small, medium, large-v3, turbo.
# Groter = nauwkeuriger maar trager. Met een NVIDIA-videokaart is "turbo" een prima keuze.
#WHISPER_MODEL=small
# Taal van de video vastzetten (bijv. nl of en); leeg = automatisch herkennen.
#WHISPER_LANGUAGE=
# YouTube-ondertitels gebruiken als die er zijn (veel sneller dan zelf transcriberen).
#USE_YOUTUBE_SUBTITLES=true

# Om de hoeveel seconden een beeld bekijken (0 = automatisch: elke 10 s, max. MAX_FRAMES beelden).
#FRAME_INTERVAL=0
#MAX_FRAMES=900

# Geluidsherkenning (lachen, schreeuwen, applaus, ...) aan/uit en hoe gevoelig.
#AUDIO_EVENTS=true
#LAUGH_THRESHOLD=0.12

# Video- en audiobestand na de analyse bewaren (standaard weggegooid; frames en resultaten blijven).
#KEEP_MEDIA=false

# Je ingelogde browser gebruiken voor downloads (chrome, firefox, edge, ...): nodig voor Twitch-VOD's
# die alleen voor abonnees zijn, of als YouTube vraagt te bevestigen dat je geen bot bent.
#COOKIES_FROM_BROWSER=

# Waar de app draait.
#PORT=8765
